[Unit]
Description=Discord birthday bot
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/discordbirthdaybot
ExecStart=%h/discordbirthdaybot/.venv/bin/python -u %h/discordbirthdaybot/main.py
Restart=always
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=discordbirthdaybot

[Install]
WantedBy=default.target
